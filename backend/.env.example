# NARCOSCOPE Backend Environment Configuration

# Application Mode
# Keep DEMO_MODE=True enabled by default for development without external services
DEMO_MODE=True

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://narcoscope_user:narcoscope_pass@localhost:5432/narcoscope_db

# Graph Database Configuration (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=narcoscope_secret_password

# Authentication & Security
JWT_SECRET=narcoscope_super_secret_jwt_key_change_in_production_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend Integration
FRONTEND_URL=http://localhost:5173
